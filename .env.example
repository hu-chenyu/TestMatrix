# ==============================================================================
# TestMatrix 环境变量配置模板
# 使用说明:
#   1. 复制本文件为 .env 并填入真实配置: cp .env.example .env
#   2. .env 文件已加入 .gitignore，不会提交到仓库，可安全存放敏感信息
#   3. 通过 TM_ENV 变量切换运行环境: dev / test / prod
# ==============================================================================

# ------------------------------ 运行环境 ------------------------------
# 当前激活环境（dev=本地开发 / test=测试环境 / prod=生产环境）
TM_ENV=dev

# ------------------------------ 日志配置 ------------------------------
# 日志输出级别: DEBUG / INFO / WARNING / ERROR
TM_LOG_LEVEL=INFO
# 日志输出目录（相对于项目根目录）
TM_LOG_DIR=output/logs

# ------------------------------ 被测服务配置 ------------------------------
# HTTP接口测试目标服务基础地址（按环境替换）
TM_BASE_URL=https://httpbin.org
# HTTP请求统一超时时间（秒）
TM_HTTP_TIMEOUT=10
# HTTP请求失败自动重试次数
TM_HTTP_RETRIES=2

# ------------------------------ 芯片板卡测试配置（扩展项，非核心） ------------------------------
# 说明（Day44 P3-23）：下列变量已从模板移除。SerialClient / TelnetClient
# 全部通过构造参数显式接收 port/baudrate/host/timeout，不读取环境变量，
# 这些键写进 .env 不会有任何效果——"配置写了不生效"是比不写更坏的静默失败面。
# 需要连板卡时在调用侧显式传参，例如：
#   SerialClient(port="COM3", baudrate=115200)
#   TelnetClient(host="192.168.1.100", port=23, timeout=10.0)

# ------------------------------ 数据库配置 ------------------------------
# 数据库类型: sqlite（本地默认） / mysql（生产或团队共用）
TM_DB_TYPE=sqlite
# SQLite数据库文件路径（仅TM_DB_TYPE=sqlite时生效）
TM_DB_SQLITE_PATH=output/testmatrix.db
# MySQL连接配置（仅TM_DB_TYPE=mysql时生效）
TM_DB_MYSQL_HOST=127.0.0.1
TM_DB_MYSQL_PORT=3306
TM_DB_MYSQL_USER=testmatrix
# MySQL 口令：留空表示"未配置"。默认 sqlite 模式无需填写。
# 切到 mysql 模式（TM_DB_TYPE=mysql）或执行
# `docker compose --profile mysql up -d` 时必须填入真实口令，
# 否则 compose 的 ${VAR:?} 守卫会直接报错退出（fail-closed，不静默用弱口令）。
# Day44 P2-02：原先此处是 your_password_here 这样的**字面占位值**，
# 而 ${VAR:?} 只拦"未设置/为空"、不拦"占位值"，run.py 自动复制本模板后
# MySQL 会真的以这串字符作为口令启动。改为留空即从源头消除该路径。
TM_DB_MYSQL_PASSWORD=
# MySQL root 口令：docker-compose.yml 的 mysql 服务强制要求此项
# （Day43 收尾 D4：原先 root 口令是明文硬编码 root123456，无覆盖入口）。
# 仅在用 `docker compose --profile mysql` 起 MySQL 联调环境时才需要，
# 同 P2-02 留空，填写要求见上。
TM_DB_MYSQL_ROOT_PASSWORD=
TM_DB_MYSQL_DATABASE=testmatrix

# ------------------------------ Redis 缓存与任务队列（Day31-33 已交付） ------------------------------
# Redis 总开关：false 时缓存层全部 no-op、任务队列走裸线程兜底，零侵入可灰度
TM_REDIS_ENABLED=false
# Redis 连接 URL；测试可用 fake:// 前缀触发 fakeredis 内存实例（零外部依赖）
TM_REDIS_URL=redis://127.0.0.1:6379/0
# 缓存默认 TTL（秒），SETEX 原子写入，到期自动失效兜底一致性
TM_CACHE_TTL=300
# 任务队列总开关：true 时 LPUSH/BRPOP 队列调度，false 或入队失败回退裸线程
TM_TASK_QUEUE_ENABLED=false
# 任务队列 Redis list 的 key（与代码默认值保持一致）
TM_TASK_QUEUE_KEY=tm:queue:tasks
# 应用内 worker 线程开关（缺省跟随 TM_TASK_QUEUE_ENABLED，可单独关闭只测入队）
TM_TASK_WORKER_ENABLED=false
# worker BRPOP 阻塞超时（秒，必须有限值以保证停止信号及时响应；与代码默认值一致）
TM_TASK_BRPOP_TIMEOUT=1

# ------------------------------ 报告与通知配置（后续阶段启用） ------------------------------
# 测试报告邮件通知开关: true / false
TM_EMAIL_ENABLED=false
TM_EMAIL_SMTP_HOST=smtp.example.com
TM_EMAIL_SMTP_PORT=465
TM_EMAIL_SENDER=sender@example.com
TM_EMAIL_PASSWORD=your_email_auth_code
TM_EMAIL_RECEIVERS=receiver1@example.com,receiver2@example.com

# ------------------------------ 企业微信机器人通知配置（后续阶段启用） ------------------------------
# 是否启用企微通知（true/false，默认false）
TM_WECHAT_ENABLED=false
# 企微机器人webhook完整URL（含key参数，在企微群机器人设置中获取）
# 格式: https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
TM_WECHAT_WEBHOOK_URL=

# ------------------------------ 通知路由策略配置 ------------------------------
# 通知策略: all=每次执行完都通知 / failed_only=仅存在失败时通知
TM_NOTIFY_STRATEGY=all
# 存在失败时是否@所有人（true/false，默认false）
TM_NOTIFY_AT_ALL=false
# 额外@的手机号列表，逗号分隔，可选（企微手机号@人）
TM_NOTIFY_OWNER_MOBILES=
# 失败后最大重试次数（首次尝试不计，总尝试=1+次数）
TM_NOTIFY_MAX_RETRIES=3
# 指数退避基准秒数（第k次失败后等待 base×2^k，序列1/2/4/8...）
TM_NOTIFY_RETRY_BASE_DELAY=1.0
# 重试等待是否加随机抖动（防多实例同时重试雪崩，默认false保证确定性）
TM_NOTIFY_RETRY_JITTER=false

# ------------------------------ 执行器配置 ------------------------------
# 用例执行器类型: simulated（模拟执行，默认） / pytest（真实pytest子进程执行）
# Web触发接口未显式传executor参数时读取本配置
TM_EXECUTOR=simulated

# ------------------------------ Web平台配置 ------------------------------
# Web服务监听地址与端口由 run.py 的命令行参数控制（--host / --port），
# 不读取环境变量，故模板中不提供 TM_WEB_* 键（Day44 P3-23 死配置清理）。
# 启动示例：
#   python run.py                      # 默认 127.0.0.1:5000，仅本机可访问
#   python run.py --host 0.0.0.0       # 对外开放，启动时会打印无鉴权安全告警
# Flask应用密钥（生产环境必须设置强随机字符串，留空则自动生成随机值）
TM_SECRET_KEY=